{
  "name": "remotion-laser-show",
  "version": "1.0.0",
  "description": "4K multicolor laser light rays, purple sand storm, liquid chrome & gold grid backgrounds - Remotion",
  "scripts": {
    "start": "remotion studio",
    "dev": "remotion studio",
    "build": "remotion render LaserShow out/laser-show.mp4 --bitrate=10000k",
    "build:4k": "remotion render LaserShow out/laser-show-4k.mp4 --pixel-format=yuv420p --bitrate=10000k",
    "build:1080": "remotion render LaserShow out/laser-show-1080.mp4 --pixel-format=yuv420p --bitrate=10000k",
    "build:sand:4k": "remotion render PurpleSandStorm out/sand-storm-4k.mp4 --pixel-format=yuv420p --bitrate=20000k --concurrency=2",
    "build:sand:1080": "remotion render PurpleSandStorm-1080 out/sand-storm-1080.mp4 --pixel-format=yuv420p --bitrate=15000k --concurrency=4",
    "build:chrome:4k": "remotion render LiquidChrome out/liquid-chrome-4k.mp4 --pixel-format=yuv420p --bitrate=25000k --concurrency=2",
    "build:chrome:1080": "remotion render LiquidChrome-1080 out/liquid-chrome-1080.mp4 --pixel-format=yuv420p --bitrate=15000k --concurrency=4",
    "build:gold:4k": "remotion render GoldGrid out/gold-grid-4k.mp4 --pixel-format=yuv420p --bitrate=25000k --concurrency=2",
    "build:gold:1080": "remotion render GoldGrid-1080 out/gold-grid-1080.mp4 --pixel-format=yuv420p --bitrate=15000k --concurrency=4",
    "build:gold:tight:4k": "remotion render GoldGridTight out/gold-grid-tight-4k.mp4 --pixel-format=yuv420p --bitrate=25000k --concurrency=2",
    "build:gold:tight:1080": "remotion render GoldGridTight-1080 out/gold-grid-tight-1080.mp4 --pixel-format=yuv420p --bitrate=15000k --concurrency=4",
    "build:neon:4k": "remotion render NeonCircuitBoard out/neon-circuit-4k.mp4 --pixel-format=yuv420p --bitrate=15000k --concurrency=2",
    "build:neon:1080": "remotion render NeonCircuitBoard-1080 out/neon-circuit-1080.mp4 --pixel-format=yuv420p --bitrate=10000k --concurrency=4",
    "build:aurora:4k": "remotion render AuroraBorealis out/aurora-4k.mp4 --pixel-format=yuv420p --bitrate=20000k --concurrency=2",
    "build:aurora:1080": "remotion render AuroraBorealis-1080 out/aurora-1080.mp4 --pixel-format=yuv420p --bitrate=15000k --concurrency=4",
    "build:gold-pour:4k": "remotion render LiquidGoldPour out/liquid-gold-4k.mp4 --pixel-format=yuv420p --bitrate=25000k --concurrency=2",
    "build:gold-pour:1080": "remotion render LiquidGoldPour-1080 out/liquid-gold-1080.mp4 --pixel-format=yuv420p --bitrate=15000k --concurrency=4",
    "build:geo:4k": "remotion render GeometricPulse out/geometric-pulse-4k.mp4 --pixel-format=yuv420p --bitrate=15000k --concurrency=2",
    "build:geo:1080": "remotion render GeometricPulse-1080 out/geometric-pulse-1080.mp4 --pixel-format=yuv420p --bitrate=10000k --concurrency=4",
    "upgrade": "remotion upgrade",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.520",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.520"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.520",
    "@types/react": "19.0.0",
    "@types/web": "0.0.166",
    "eslint": "9.27.0",
    "typescript": "5.8.3"
  },
  "private": true
}
