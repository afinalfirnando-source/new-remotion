{
  "name": "remotion-laser-show",
  "version": "1.0.0",
  "description": "4K multicolor laser light rays, purple sand storm, liquid chrome & gold grid backgrounds - Remotion",
  "scripts": {
    "start": "remotion studio",
    "dev": "remotion studio",
    "build": "remotion render LaserShow out/laser-show.mp4 --pixel-format=yuv420p --video-bitrate=26M",
    "build:4k": "remotion render LaserShow out/laser-show-4k.mp4 --pixel-format=yuv420p --video-bitrate=26M",
    "build:1080": "remotion render LaserShow-1080 out/laser-show-1080.mp4 --pixel-format=yuv420p --video-bitrate=26M",
    "build:sand:4k": "remotion render PurpleSandStorm out/sand-storm-4k.mp4 --pixel-format=yuv420p --video-bitrate=20M --concurrency=2",
    "build:sand:1080": "remotion render PurpleSandStorm-1080 out/sand-storm-1080.mp4 --pixel-format=yuv420p --video-bitrate=20M --concurrency=4",
    "build:chrome:4k": "remotion render LiquidChrome out/liquid-chrome-4k.mp4 --pixel-format=yuv420p --video-bitrate=25M --concurrency=2",
    "build:chrome:1080": "remotion render LiquidChrome-1080 out/liquid-chrome-1080.mp4 --pixel-format=yuv420p --video-bitrate=25M --concurrency=4",
    "build:gold:4k": "remotion render GoldGrid out/gold-grid-4k.mp4 --pixel-format=yuv420p --video-bitrate=25M --concurrency=2",
    "build:gold:1080": "remotion render GoldGrid-1080 out/gold-grid-1080.mp4 --pixel-format=yuv420p --video-bitrate=25M --concurrency=4",
    "build:gold:tight:4k": "remotion render GoldGridTight out/gold-grid-tight-4k.mp4 --pixel-format=yuv420p --video-bitrate=25M --concurrency=2",
    "build:gold:tight:1080": "remotion render GoldGridTight-1080 out/gold-grid-tight-1080.mp4 --pixel-format=yuv420p --video-bitrate=25M --concurrency=4",
    "build:crystal:4k": "remotion render EtherealCrystal out/ethereal-crystal-4k.mp4 --pixel-format=yuv420p --video-bitrate=25M --concurrency=2",
    "build:crystal:1080": "remotion render EtherealCrystal-1080 out/ethereal-crystal-1080.mp4 --pixel-format=yuv420p --video-bitrate=25M --concurrency=4",
    "upgrade": "remotion upgrade",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.520",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.520"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.520",
    "@types/react": "19.0.0",
    "@types/web": "0.0.166",
    "eslint": "9.27.0",
    "typescript": "5.8.3"
  },
  "private": true
}
